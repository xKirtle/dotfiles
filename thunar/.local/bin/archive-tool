#!/usr/bin/env bash
# Extract / create archives from Thunar's right-click menu (no archive manager app needed).
#   archive-tool extract-here <archive>...   one top-level item lands here; anything else goes
#                                            into a folder named after the archive
#   archive-tool extract-to <archive>...     always into a folder named after the archive
#   archive-tool compress <file>...          zip the selection into <name>.zip next to it
# Extraction uses bsdtar (libarchive: zip, 7z, rar, tar.*, iso, cab, cpio, xar), falling back to
# 7z. Both refuse absolute paths and "..", so an archive can't write outside its target folder.
# Nothing is overwritten: name clashes get " (2)", " (3)", …
# Used by Thunar's custom actions (~/.config/Thunar/uca.xml).
set -uo pipefail

notify() { notify-send -a Thunar -i package-x-generic "$@" 2>/dev/null || echo "$*" >&2; }

# "foo.tar.gz" -> "foo"
stem() {
    local n
    n=$(basename -- "$1")
    for ext in .tar.gz .tar.xz .tar.zst .tar.bz2 .tar.lz .tar.lzma .tgz .txz .tzst .tbz .tbz2 \
               .zip .7z .rar .tar .iso .cab .jar .cpio .xar; do
        if [[ "${n,,}" == *"$ext" ]]; then printf '%s' "${n:0:${#n}-${#ext}}"; return; fi
    done
    printf '%s' "${n%.*}"
}

# First free path: "<dir>/<name>", then "<dir>/<name> (2)", … (suffix before the extension for files)
free_path() {
    local dir=$1 name=$2 base ext i=2
    [[ -e "$dir/$name" ]] || { printf '%s' "$dir/$name"; return; }
    if [[ "$name" == *.* && "$name" != .* ]]; then base=${name%.*} ext=".${name##*.}"; else base=$name ext=""; fi
    while [[ -e "$dir/$base ($i)$ext" ]]; do ((i++)); done
    printf '%s' "$dir/$base ($i)$ext"
}

# Extract <archive> into the empty directory <dest>; prints an error message on failure.
unpack() {
    local archive=$1 dest=$2 err
    if err=$(bsdtar -xf "$archive" -C "$dest" 2>&1); then return 0; fi
    rm -rf -- "${dest:?}"/* "${dest:?}"/.[!.]* 2>/dev/null
    # -p'' gives encrypted archives an empty password instead of an interactive prompt.
    if 7z x -y -bso0 -bsp0 -p'' -o"$dest" -- "$archive" >/dev/null 2>"$dest/.7z-err"; then
        rm -f -- "$dest/.7z-err"; return 0
    fi
    if grep -qi -E 'wrong password|encrypted' "$dest/.7z-err"; then
        echo "It's password-protected (not supported here; open it with 7z in a terminal)."
    else
        echo "${err:-$(head -c 300 "$dest/.7z-err")}"
    fi
    rm -f -- "$dest/.7z-err"
    return 1
}

extract() {
    local mode=$1 archive=$2 parent name tmp items target err
    archive=$(realpath -- "$archive")
    parent=$(dirname -- "$archive")
    name=$(stem "$archive")
    [[ -w "$parent" ]] || { notify "Can't extract $(basename -- "$archive")" "No write permission in $parent"; return 1; }
    tmp=$(mktemp -d "$parent/.extracting-XXXXXX") || return 1  # same filesystem: the final move is a rename
    if ! err=$(unpack "$archive" "$tmp"); then
        rm -rf -- "$tmp"
        notify "Couldn't extract $(basename -- "$archive")" "$err"
        return 1
    fi
    mapfile -t items < <(find "$tmp" -mindepth 1 -maxdepth 1 -printf '%f\n')
    if [[ ${#items[@]} -eq 0 ]]; then
        rm -rf -- "$tmp"
        notify "$(basename -- "$archive") is empty"
        return 0
    fi
    if [[ "$mode" == here && ${#items[@]} -eq 1 ]]; then
        target=$(free_path "$parent" "${items[0]}")
        mv -- "$tmp/${items[0]}" "$target" && rmdir -- "$tmp"
    else
        target=$(free_path "$parent" "$name")
        mv -- "$tmp" "$target"
        chmod u+rwx,go+rx -- "$target"  # mktemp made it 0700
    fi
    notify "Extracted $(basename -- "$archive")" "→ $(basename -- "$target")"
}

compress() {
    local first parent name out tmp item
    first=$(realpath -- "$1")
    parent=$(dirname -- "$first")
    for item in "$@"; do
        [[ "$(dirname -- "$(realpath -- "$item")")" == "$parent" ]] || { notify "Compress" "Select files from one folder"; return 1; }
    done
    if [[ $# -eq 1 ]]; then name=$(basename -- "$first"); name=${name%.*}; [[ -n "$name" ]] || name=$(basename -- "$first")
    else name=$(basename -- "$parent"); fi
    out=$(free_path "$parent" "$name.zip")
    tmp="$out.part"
    local rel=()
    # ./ so names starting with - aren't options; -s strips it again inside the zip (Windows shows it as a folder)
    for item in "$@"; do rel+=("./$(basename -- "$item")"); done
    if err=$(cd "$parent" && bsdtar --format zip -s ",^\./,," -cf "$tmp" "${rel[@]}" 2>&1) && mv -- "$tmp" "$out"; then
        notify "Compressed $# item$([[ $# -eq 1 ]] || echo s)" "→ $(basename -- "$out")"
    else
        rm -f -- "$tmp"
        notify "Couldn't compress" "${err:-bsdtar failed}"
        return 1
    fi
}

cmd=${1:-}; shift || true
[[ $# -ge 1 ]] || { sed -n '2,9p' "$0" >&2; exit 2; }
case "$cmd" in
    extract-here) rc=0; for a in "$@"; do extract here "$a" || rc=1; done; exit $rc ;;
    extract-to)   rc=0; for a in "$@"; do extract to "$a" || rc=1; done; exit $rc ;;
    compress)     compress "$@" ;;
    *)            sed -n '2,9p' "$0" >&2; exit 2 ;;
esac
