[Desktop Entry]
Type=Application
Name=Browse archive
Comment=Open an archive as a read-only folder in Thunar (drag files out of it)
Icon=package-x-generic
# The session PATH lacks ~/.local/bin, hence sh -c with $HOME (quoting per the desktop-entry spec).
Exec=sh -c "exec \\"\\$HOME/.local/bin/archive-mount\\" open \\"\\$1\\"" sh %f
Terminal=false
NoDisplay=true
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;application/x-cd-image;application/vnd.ms-cab-compressed;application/x-cpio;
