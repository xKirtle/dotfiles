# Private values for the dotfiles. Copy to .env (gitignored) and fill in:
#   cp .env.example .env
# Format: KEY=value, one per line, no `export`, no shell expansion. Quotes around the
# value are optional and stripped. install.sh reads this and renders every *.template.

# Caelestia weather: a place name (Open-Meteo geocoder, first match) or "lat,lon".
WEATHER_LOCATION=Your Town, Region

# Proton Calendar read-only ICS subscription link (Proton Calendar > Settings > calendar >
# Share > "Share with anyone"). Anyone with it can read the calendar: keep it out of git.
PROTON_CALENDAR_URL=
