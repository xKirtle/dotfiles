# Personal — GitHub (aliased since github.com is shared with Work below)
Host github.com-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes

# Personal — GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes

# Work — GitHub (aliased since github.com is shared with Personal above)
Host github.com-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_work
    IdentitiesOnly yes

# Work — Azure DevOps
Host ssh.dev.azure.com
    HostName ssh.dev.azure.com
    User git
    IdentityFile ~/.ssh/id_ed25519_work
    IdentitiesOnly yes

# Homelab — one key for every LAN host
Host pi
    HostName 192.168.1.10
    User username

Host nas
    HostName 192.168.1.20
    User beepbopbop

Host minipc
    HostName 192.168.1.21
    User username

Host pi nas minipc 192.168.1.10 192.168.1.20 192.168.1.21
    IdentityFile ~/.ssh/id_ed25519_homelab
    IdentitiesOnly yes
