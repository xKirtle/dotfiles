        "keybindingLabel.background": h("surfaceContainerHigh"), "keybindingLabel.foreground": h("onSurface"),
        "keybindingLabel.border": h("outlineVariant"), "keybindingLabel.bottomBorder": h("outlineVariant"),
        # lists and trees
        "list.hoverBackground": h("surfaceContainerHigh"),
        "list.activeSelectionBackground": h("surfaceContainerHighest"),
        "list.activeSelectionForeground": h("onSurface"),
        "list.inactiveSelectionBackground": h("surfaceContainerHigh"),
        "list.focusOutline": h("primary", "80"), "list.highlightForeground": h("primary"),
        "list.errorForeground": h("error"), "list.warningForeground": h(warn),
        "tree.indentGuidesStroke": h("outlineVariant"),
        # workbench parts
        "titleBar.activeBackground": h("surfaceContainerLowest"),
        "titleBar.activeForeground": h("onSurfaceVariant"),
        "titleBar.inactiveBackground": h("surfaceContainerLowest"), "titleBar.inactiveForeground": h("outline"),
