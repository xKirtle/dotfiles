#!/usr/bin/env python3
"""Omarchy-style themes on top of Caelestia: a theme = a wallpaper folder + a colour scheme.

  themectl list [--json]        themes in ~/Pictures/Wallpapers/<theme>/
  themectl set <theme> [file]
                                apply a theme's scheme + wallpaper (first one, or `file`)
  themectl current              print the current theme and wallpaper
  themectl picker [themes|wallpapers]
                                toggle a picker (~/.config/quickshell/theme-picker)
  themectl sync                 daemon: mirror Caelestia's wallpaper onto awww with a
                                grow-from-cursor transition (themectl-sync.service)
  themectl vscode               install the "Caelestia" VS Code theme (once; sync keeps it current)

Wallpapers always go through `caelestia wallpaper`, so Caelestia's own picker, the lock screen
and the dynamic scheme stay in sync; `sync` then draws them with awww (Caelestia's own
wallpaper layer is disabled with background.wallpaperEnabled = false).

A theme's scheme comes from its folder name, `<scheme>` or `<scheme>-<flavour>` (e.g.
catppuccin-mocha, gruvbox-hard), or from an optional `scheme` file inside the folder
containing "<scheme> [flavour] [dark|light]" (e.g. "catppuccin latte light", "dynamic").
Anything unrecognised uses the dynamic scheme (colours from the wallpaper).
"""
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
WALLPAPERS = os.environ.get("THEMECTL_WALLPAPERS", f"{HOME}/Pictures/Wallpapers")
STATE_DIR = f"{os.environ.get('XDG_STATE_HOME', HOME + '/.local/state')}"
STATE = f"{STATE_DIR}/themectl/current.json"
CAELESTIA_WALL = f"{STATE_DIR}/caelestia/wallpaper/path.txt"
CAELESTIA_SCHEME = f"{STATE_DIR}/caelestia/scheme.json"
CHROMIUM_POLICY_DIR = "/etc/chromium/policies/managed"
IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".tif", ".tiff")

TRANSITION_DURATION = "1.4"  # seconds


def run(*cmd, check=True):
    return subprocess.run(cmd, check=check, capture_output=True, text=True).stdout


# ---------------------------------------------------------------- themes

_schemes = None


def schemes():
    """{name: {flavour: colours}} from caelestia."""
    global _schemes
    if _schemes is None:
        try:
            _schemes = json.loads(run("caelestia", "scheme", "list"))
        except (subprocess.CalledProcessError, ValueError, OSError):
            _schemes = {}
    return _schemes


def parse_scheme(spec):
    """'catppuccin mocha dark' / 'gruvbox-hard' / 'dynamic' -> (name, flavour, mode)."""
    words = spec.replace("-", " ").split()
    name = words[0] if words else "dynamic"
    if name not in schemes() or name == "dynamic":
        return "dynamic", None, None
    flavours = schemes()[name]
    flavour = next((w for w in words[1:] if w in flavours), next(iter(flavours)))
    mode = next((w for w in words[1:] if w in ("dark", "light")), None)
    return name, flavour, mode


def theme_scheme(theme):
    path = f"{WALLPAPERS}/{theme}/scheme"
    try:
        with open(path) as f:
            return parse_scheme(f.read().strip())
    except OSError:
        return parse_scheme(theme)


UNSORTED = "unsorted"  # pseudo-theme: images directly in WALLPAPERS, dynamic colours


def wallpapers(theme):
    folder = f"{WALLPAPERS}/{theme}"
    if theme == UNSORTED and not os.path.isdir(folder):
        folder = WALLPAPERS
    try:
        files = sorted(f for f in os.listdir(folder) if f.lower().endswith(IMAGE_EXTS))
    except OSError:
        return []
    return [f"{folder}/{f}" for f in files]


def themes():
    try:
        names = sorted(d for d in os.listdir(WALLPAPERS) if os.path.isdir(f"{WALLPAPERS}/{d}"))
    except OSError:
        return []
    if UNSORTED not in names:
        names.append(UNSORTED)
    return [t for t in names if wallpapers(t)]


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(theme, wallpaper):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump({"theme": theme, "wallpaper": wallpaper}, f)


# ---------------------------------------------------------------- commands

def cmd_list(as_json):
    st = load_state()
    cur, cur_wall = st.get("theme"), st.get("wallpaper")
    out = []
    for t in themes():
        name, flavour, mode = theme_scheme(t)
        colours = schemes().get(name, {}).get(flavour, {}) if name != "dynamic" else {}
        out.append({
            "name": t,
            "scheme": name,
            "flavour": flavour,
            "mode": mode,
            "current": t == cur,
            "current_wallpaper": cur_wall if t == cur else None,
            "wallpapers": wallpapers(t),
            "swatches": ["#" + colours[k] for k in ("primary", "secondary", "tertiary", "surface", "onSurface")
                         if k in colours],
        })
    if as_json:
        print(json.dumps(out))
    else:
        for t in out:
            scheme = " ".join(p for p in (t["scheme"], t["flavour"], t["mode"]) if p)
            print(f"{'*' if t['current'] else ' '} {t['name']:24} {scheme:28} {len(t['wallpapers'])} wallpaper(s)")


def apply_wallpaper(theme, wallpaper):
    name, flavour, mode = theme_scheme(theme)
    if name == "dynamic":
        # Set the wallpaper first so the dynamic scheme is generated from it.
        run("caelestia", "wallpaper", "-f", wallpaper)
        try:
            with open(CAELESTIA_SCHEME) as f:
                current = json.load(f).get("name")
        except (OSError, ValueError):
            current = None
        if current != "dynamic":
            run("caelestia", "scheme", "set", "-n", "dynamic")
    else:
        run("caelestia", "wallpaper", "-f", wallpaper, "-N")
    save_state(theme, wallpaper)


def cmd_set(theme, wallpaper=None):
    walls = wallpapers(theme)
    if not walls:
        sys.exit(f"themectl: no theme '{theme}' (or it has no wallpapers) in {WALLPAPERS}")
    if wallpaper and os.path.abspath(wallpaper) not in walls:
        sys.exit(f"themectl: {wallpaper} is not in theme '{theme}'")
    name, flavour, mode = theme_scheme(theme)
    if name != "dynamic":
        args = ["caelestia", "scheme", "set", "-n", name, "-f", flavour]
        if mode:
            args += ["-m", mode]
        run(*args)
    apply_wallpaper(theme, os.path.abspath(wallpaper) if wallpaper else walls[0])


def cmd_current():
    st = load_state()
    print(f"{st.get('theme', '(none)')}\n{st.get('wallpaper', '')}")


def cmd_picker(mode):
    ipc = ["qs", "-c", "theme-picker", "ipc", "call", "picker", "toggle", mode]
    if subprocess.run(ipc, capture_output=True).returncode != 0:
        subprocess.Popen(["qs", "-c", "theme-picker", "-d"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(30):
            time.sleep(0.1)
            if subprocess.run(ipc, capture_output=True).returncode == 0:
                break


# ---------------------------------------------------------------- sync daemon

def hypr_json(*args):
    return json.loads(run("hyprctl", *args, "-j"))


def awww_show(path, grow):
    """Show `path` on every output; grow from the cursor on its monitor, from the centre elsewhere."""
    try:
        cur, mons = hypr_json("cursorpos"), hypr_json("monitors")
    except (subprocess.CalledProcessError, ValueError, OSError):
        cur, mons = None, []
    if not mons:
        subprocess.run(["awww", "img", path, "--transition-type", "grow" if grow else "simple"])
        return
    procs = []
    for m in mons:
        w, h = m["width"] / m["scale"], m["height"] / m["scale"]
        if m["transform"] % 2:
            w, h = h, w
        args = ["awww", "img", path, "-o", m["name"],
                "--transition-fps", str(round(m["refreshRate"])),
                "--transition-duration", TRANSITION_DURATION]
        if grow:
            pos = "center"
            if cur and m["x"] <= cur["x"] < m["x"] + w and m["y"] <= cur["y"] < m["y"] + h:
                fx, fy = (cur["x"] - m["x"]) / w, (cur["y"] - m["y"]) / h
                pos = f"{fx:.3f},{1 - fy:.3f}"  # awww measures y from the bottom
            args += ["--transition-type", "grow", "--transition-pos", pos]
        else:
            args += ["--transition-type", "simple", "--transition-step", "255"]
        procs.append(subprocess.Popen(args))
    for p in procs:
        p.wait()


def cmd_sync():
    from gi.repository import Gio, GLib

    def wait_for_daemon():
        for _ in range(100):
            if subprocess.run(["awww", "query"], capture_output=True).returncode == 0:
                return
            time.sleep(0.1)
        sys.exit("themectl sync: awww-daemon isn't running")

    def read_path():
        try:
            with open(CAELESTIA_WALL) as f:
                p = f.read().strip()
            return p if os.path.isfile(p) else None
        except OSError:
            return None

    wait_for_daemon()
    shown = {"path": read_path()}
    if shown["path"]:
        awww_show(shown["path"], grow=False)  # startup: no animation

    def apply_wallpaper():
        p = read_path()
        if p and p != shown["path"]:
            shown["path"] = p
            awww_show(p, grow=True)

    timers, monitors = {}, []

    def watch(path, callback):
        """Call `callback` (debounced) whenever the file at `path` is written or replaced."""
        def fire():
            timers.pop(path, None)
            callback()
            return False

        def changed(_mon, file, other, event):
            # Caelestia writes atomically (temp file + rename), so for RENAMED the target is `other`.
            if path in (file.get_path(), other and other.get_path()) and event in (
                    Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                    Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.RENAMED):
                if path in timers:
                    GLib.source_remove(timers[path])
                timers[path] = GLib.timeout_add(120, fire)  # debounce bursts of writes

        os.makedirs(os.path.dirname(path), exist_ok=True)
        mon = Gio.File.new_for_path(os.path.dirname(path)).monitor_directory(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        mon.connect("changed", changed)
        monitors.append(mon)  # keep a reference, or the monitor is garbage-collected

    watch(CAELESTIA_WALL, apply_wallpaper)
    watch(CAELESTIA_SCHEME, on_scheme_change)
    GLib.MainLoop().run()


def on_scheme_change():
    """Push the new scheme to the places Caelestia doesn't reach on this system."""
    try:
        with open(CAELESTIA_SCHEME) as f:
            c = json.load(f)["colours"]
    except (OSError, ValueError, KeyError):
        return
    for apply in (hypr_borders, chromium_theme, serein_theme, vscode_theme):
        try:
            apply(c)
        except (KeyError, OSError, subprocess.SubprocessError) as e:
            print(f"themectl sync: {apply.__name__}: {e}", file=sys.stderr)


def hypr_borders(c):
    """Border colours, live (same mapping as the block in qol.lua)."""
    active = [f"rgba({c['primary'].lower()}ee)", f"rgba({c['tertiary'].lower()}ee)"]
    inactive = f"rgba({c['outlineVariant'].lower()}aa)"
    lua = ('hl.config({ general = { col = { active_border = { colors = {"%s", "%s"}, angle = 45 }, '
           'inactive_border = "%s" } } })' % (*active, inactive))
    subprocess.run(["hyprctl", "eval", lua], capture_output=True)


def chromium_theme(c):
    """Chromium's toolbar colour via a managed policy. Caelestia's own version needs passwordless
    sudo; this needs the policy dir to be writable instead (one-time: sudo install -d -o $USER ...)."""
    if not os.access(CHROMIUM_POLICY_DIR, os.W_OK):
        return
    tmp = f"{CHROMIUM_POLICY_DIR}/.caelestia.json.tmp"
    with open(tmp, "w") as f:
        json.dump({"BrowserThemeColor": "#" + c["surface"].lower(), "BrowserColorScheme": "device"}, f)
    os.replace(tmp, f"{CHROMIUM_POLICY_DIR}/caelestia.json")
    # Only nudge a running browser; with no instance this flag would start a hidden one.
    if subprocess.run(["pgrep", "-x", "chromium"], capture_output=True).returncode == 0:
        subprocess.Popen(["chromium", "--refresh-platform-policy", "--no-startup-window"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


SEREIN_THEMES = f"{os.environ.get('XDG_DATA_HOME', HOME + '/.local/share')}/serein/extensions/themes"
SEREIN_THEME_ID = "caelestia-scheme"


def serein_theme(c):
    """Serein (native Discord client) theme, written as a local theme into its own store
    (themes/<id>/package.json, the format Settings > Themes > Create theme saves). Serein only
    reads the store at startup, so a running Serein shows new colours after a restart."""
    if not os.path.isdir(SEREIN_THEMES):
        return  # Serein not installed / never started
    import hashlib

    def h(key, alpha=""):
        return "#" + c[key].lower() + alpha

    colors = {
        "base": h("surfaceContainerLowest"),   # server rail / window
        "sidebar": h("surface"),              # channel + member lists
        "chat": h("surfaceContainerLow"),     # message area
        "raised": h("surfaceContainer"),      # cards, popouts
        "hover": h("surfaceContainerHigh"),
        "selected": h("surfaceContainerHighest"),
        "border": h("outlineVariant"),
        "text_strong": h("onSurface"),
        "text": h("onSurfaceVariant"),
        "muted": h("outline"),
        "link": h("tertiary"),
        "accent": h("primary"),
        "accent_text": h("onPrimary"),
        "positive": h("success" if "success" in c else "term2"),
        "warning": h("yellow" if "yellow" in c else "term3"),
        "danger": h("error"),
        "mention_bg": h("primary", "26"),     # ~15% primary over the message row
        "mention_text": h("primary"),
    }
    palette = {"colors": colors, "backdrop": None}
    package = {
        "manifest": {"api_version": 1, "id": SEREIN_THEME_ID, "name": "Caelestia",
                     "version": "1.0.0", "author": "themectl", "license": "MIT", "source": "",
                     "kind": "theme", "capabilities": [], "actions": []},
        # Same palette for both appearances, so Serein matches the desktop either way.
        "theme": {"light": palette, "dark": palette, "style": {}},
    }
    encoded = json.dumps(package, separators=(",", ":")).encode()
    stored = {"local_theme": True, "package": package, "grants": [], "reviewed": False,
              "sha256": hashlib.sha256(encoded).hexdigest(), "download_bytes": len(encoded)}
    directory = f"{SEREIN_THEMES}/{SEREIN_THEME_ID}"
    if os.path.exists(f"{directory}.disabled"):
        return  # Serein is cleaning up after "Disable"; leave it alone
    os.makedirs(directory, exist_ok=True)
    tmp = f"{directory}/package.partial"  # Serein's own temp name; it deletes leftovers on load
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(stored, f, separators=(",", ":"))
    os.replace(tmp, f"{directory}/package.json")


VSCODE_EXTENSIONS = f"{HOME}/.vscode/extensions"
VSCODE_EXT_ID = "themectl.caelestia-theme"
VSCODE_EXT_VERSION = "1.0.0"


def vscode_install():
    """Build a minimal VSIX for the "Caelestia" theme and install it with `code`. VS Code ignores
    extension folders it didn't install itself, hence the package. `_watch` makes VS Code reload
    the theme file whenever it changes, so vscode_theme() recolours open windows live."""
    import tempfile
    import zipfile
    publisher, name = VSCODE_EXT_ID.split(".")
    theme = {"path": "./themes/caelestia.json", "_watch": True}
    package = {
        "name": name, "displayName": "Caelestia", "publisher": publisher,
        "version": VSCODE_EXT_VERSION, "description": "Colours from the current Caelestia scheme (themectl)",
        "engines": {"vscode": "^1.60.0"}, "categories": ["Themes"],
        # Same file twice: pick by base. "Caelestia Light" is for light schemes / autoDetectColorScheme.
        "contributes": {"themes": [{"label": "Caelestia", "uiTheme": "vs-dark", **theme},
                                   {"label": "Caelestia Light", "uiTheme": "vs", **theme}]},
    }
    manifest = f"""<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Language="en-US" Id="{name}" Version="{VSCODE_EXT_VERSION}" Publisher="{publisher}"/>
    <DisplayName>Caelestia</DisplayName>
    <Description xml:space="preserve">{package["description"]}</Description>
    <Categories>Themes</Categories>
    <Properties><Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.60.0"/></Properties>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Code"/></Installation>
  <Dependencies/>
  <Assets><Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/></Assets>
</PackageManifest>
"""
    types = ('<?xml version="1.0" encoding="utf-8"?><Types xmlns="http://schemas.openxmlformats.org/'
             'package/2006/content-types"><Default Extension=".json" ContentType="application/json"/>'
             '<Default Extension=".vsixmanifest" ContentType="text/xml"/></Types>')
    with tempfile.TemporaryDirectory() as tmp:
        vsix = f"{tmp}/caelestia-theme.vsix"
        with zipfile.ZipFile(vsix, "w") as z:
            z.writestr("[Content_Types].xml", types)
            z.writestr("extension.vsixmanifest", manifest)
            z.writestr("extension/package.json", json.dumps(package, indent=2))
            z.writestr("extension/themes/caelestia.json", "{}")
        run("code", "--install-extension", vsix, "--force")
    with open(CAELESTIA_SCHEME) as f:
        vscode_theme(json.load(f)["colours"])
    print('Installed. Pick it once: Ctrl+K Ctrl+T > "Caelestia".')


def vscode_theme(c):
    """The VS Code colour theme (see vscode_install), rewritten in the installed extension.
    UI = the same Material roles as Serein; syntax = Caelestia's named colours with a
    Catppuccin-style mapping; integrated terminal = term0-15 (matches kitty)."""
    import glob
    dirs = sorted(glob.glob(f"{VSCODE_EXTENSIONS}/{VSCODE_EXT_ID}-*/themes"))
    if not dirs:
        return  # not installed (themectl vscode)

    def h(key, alpha=""):
        return "#" + c[key].lower() + alpha

    def n(key, fallback):
        """A named colour (rosewater..lavender); older schemes may lack them."""
        return h(key if key in c else fallback)

    s = c["surface"]
    light = sum(int(s[i:i + 2], 16) for i in (0, 2, 4)) > 3 * 128
    ok = "success" if "success" in c else "term2"
    warn = "yellow" if "yellow" in c else "term3"
    colors = {
        # base
        "foreground": h("onSurface"), "descriptionForeground": h("onSurfaceVariant"),
        "disabledForeground": h("outline"), "errorForeground": h("error"),
        "icon.foreground": h("onSurfaceVariant"), "focusBorder": h("primary", "99"),
        "contrastBorder": "#00000000", "widget.shadow": h("shadow", "66"),
        "selection.background": h("primary", "40"), "sash.hoverBorder": h("primary"),
        "textLink.foreground": h("tertiary"), "textLink.activeForeground": h("tertiaryFixed"),
        "textBlockQuote.background": h("surfaceContainer"), "textBlockQuote.border": h("primary"),
        "textCodeBlock.background": h("surfaceContainer"), "textPreformat.foreground": h("tertiary"),
        "textSeparator.foreground": h("outlineVariant"), "progressBar.background": h("primary"),
        # editor
        "editor.background": h("surface"), "editor.foreground": h("onSurface"),
        "editorCursor.foreground": h("primary"),
        "editor.lineHighlightBackground": h("surfaceContainerLow"),
        "editor.lineHighlightBorder": "#00000000",
        "editor.selectionBackground": h("primary", "40"),
        "editor.inactiveSelectionBackground": h("primary", "26"),
        "editor.selectionHighlightBackground": h("primary", "1f"),
        "editor.wordHighlightBackground": h("secondary", "26"),
        "editor.wordHighlightStrongBackground": h("secondary", "40"),
        "editor.findMatchBackground": h("tertiary", "55"), "editor.findMatchBorder": h("tertiary"),
        "editor.findMatchHighlightBackground": h("tertiary", "2e"),
        "editor.findRangeHighlightBackground": h("surfaceContainerHigh", "80"),
        "editor.rangeHighlightBackground": h("surfaceContainerHigh", "80"),
        "editor.hoverHighlightBackground": h("primary", "1f"),
        "editorLink.activeForeground": h("tertiary"),
        "editorLineNumber.foreground": h("outline", "99"),
        "editorLineNumber.activeForeground": h("onSurfaceVariant"),
        "editorIndentGuide.background1": h("outlineVariant", "80"),
        "editorIndentGuide.activeBackground1": h("outline"),
        "editorWhitespace.foreground": h("outlineVariant"), "editorRuler.foreground": h("outlineVariant"),
        "editorCodeLens.foreground": h("outline"),
        "editorBracketMatch.background": h("primary", "26"), "editorBracketMatch.border": h("primary", "80"),
        "editorBracketHighlight.foreground1": h("primary"),
        "editorBracketHighlight.foreground2": h("tertiary"),
        "editorBracketHighlight.foreground3": h("secondary"),
        "editorBracketHighlight.foreground4": n("blue", "term4"),
        "editorBracketHighlight.foreground5": n("peach", "term3"),
        "editorBracketHighlight.foreground6": n("green", "term2"),
        "editorBracketHighlight.unexpectedBracket.foreground": h("error"),
        "editorError.foreground": h("error"), "editorWarning.foreground": h(warn),
        "editorInfo.foreground": n("blue", "term4"), "editorHint.foreground": h(ok),
        "editorInlayHint.foreground": h("outline"), "editorInlayHint.background": h("surfaceContainer", "b3"),
        "editorGhostText.foreground": h("outline"),
        "editorGutter.background": h("surface"),
        "editorGutter.addedBackground": h(ok), "editorGutter.modifiedBackground": n("blue", "term4"),
        "editorGutter.deletedBackground": h("error"),
        "editorOverviewRuler.border": "#00000000",
        "editorStickyScroll.background": h("surface"),
        "editorStickyScrollHover.background": h("surfaceContainerLow"),
        "diffEditor.insertedTextBackground": h(ok, "26"), "diffEditor.removedTextBackground": h("error", "26"),
        "diffEditor.insertedLineBackground": h(ok, "14"), "diffEditor.removedLineBackground": h("error", "14"),
        "merge.currentHeaderBackground": h(ok, "66"), "merge.incomingHeaderBackground": n("blue", "term4") + "66",
        # widgets, menus, inputs
        "editorWidget.background": h("surfaceContainer"), "editorWidget.border": h("outlineVariant"),
        "editorHoverWidget.background": h("surfaceContainer"), "editorHoverWidget.border": h("outlineVariant"),
        "editorSuggestWidget.background": h("surfaceContainer"), "editorSuggestWidget.border": h("outlineVariant"),
        "editorSuggestWidget.selectedBackground": h("surfaceContainerHighest"),
        "editorSuggestWidget.highlightForeground": h("primary"),
        "editorSuggestWidget.focusHighlightForeground": h("primary"),
        "quickInput.background": h("surfaceContainer"),
        "quickInputList.focusBackground": h("surfaceContainerHighest"),
        "pickerGroup.foreground": h("primary"), "pickerGroup.border": h("outlineVariant"),
        "menu.background": h("surfaceContainer"), "menu.foreground": h("onSurface"),
        "menu.selectionBackground": h("surfaceContainerHighest"), "menu.selectionForeground": h("onSurface"),
        "menu.separatorBackground": h("outlineVariant"), "menu.border": h("outlineVariant"),
        "notifications.background": h("surfaceContainer"), "notifications.border": h("outlineVariant"),
        "notificationCenterHeader.background": h("surfaceContainerHigh"),
        "notificationsErrorIcon.foreground": h("error"), "notificationsWarningIcon.foreground": h(warn),
        "notificationsInfoIcon.foreground": n("blue", "term4"),
        "input.background": h("surfaceContainerHigh"), "input.foreground": h("onSurface"),
        "input.border": h("outlineVariant"), "input.placeholderForeground": h("outline"),
        "inputOption.activeBackground": h("primary", "33"), "inputOption.activeBorder": h("primary"),
        "inputOption.activeForeground": h("onSurface"),
        "inputValidation.errorBackground": h("errorContainer"), "inputValidation.errorBorder": h("error"),
        "inputValidation.warningBackground": h("surfaceContainerHigh"), "inputValidation.warningBorder": h(warn),
        "inputValidation.infoBackground": h("surfaceContainerHigh"), "inputValidation.infoBorder": n("blue", "term4"),
        "dropdown.background": h("surfaceContainerHigh"), "dropdown.border": h("outlineVariant"),
        "dropdown.listBackground": h("surfaceContainer"),
        "checkbox.background": h("surfaceContainerHigh"), "checkbox.border": h("outlineVariant"),
        "button.background": h("primary"), "button.foreground": h("onPrimary"),
        "button.hoverBackground": h("primaryFixedDim" if light else "primaryFixed"),
        "button.secondaryBackground": h("secondaryContainer"),
        "button.secondaryForeground": h("onSecondaryContainer"),
