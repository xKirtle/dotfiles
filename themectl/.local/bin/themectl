        "statusBar.background": h("surfaceContainerLowest"), "statusBar.foreground": h("onSurfaceVariant"),
        "statusBar.border": h("outlineVariant"),
        "statusBar.noFolderBackground": h("surfaceContainerLowest"),
        "statusBar.debuggingBackground": h("tertiaryContainer"),
        "statusBar.debuggingForeground": h("onTertiaryContainer"),
        "statusBarItem.hoverBackground": h("surfaceContainerHigh"),
        "statusBarItem.remoteBackground": h("primary"), "statusBarItem.remoteForeground": h("onPrimary"),
        "statusBarItem.errorBackground": h("errorContainer"),
        "statusBarItem.errorForeground": h("onErrorContainer"),
        "peekView.border": h("primary"), "peekViewTitle.background": h("surfaceContainer"),
        "peekViewEditor.background": h("surfaceContainerLow"),
        "peekViewResult.background": h("surfaceContainer"),
        "peekViewEditor.matchHighlightBackground": h("tertiary", "40"),
        "peekViewResult.matchHighlightBackground": h("tertiary", "40"),
        "peekViewResult.selectionBackground": h("surfaceContainerHighest"),
        "minimap.selectionHighlight": h("primary", "66"),
        "minimapSlider.background": h("onSurface", "1a"),
        "welcomePage.tileBackground": h("surfaceContainer"),
        "settings.headerForeground": h("onSurface"), "settings.modifiedItemIndicator": h("primary"),
        # git / SCM decorations
        "gitDecoration.addedResourceForeground": h(ok),
        "gitDecoration.untrackedResourceForeground": h(ok),
        "gitDecoration.modifiedResourceForeground": n("blue", "term4"),
        "gitDecoration.deletedResourceForeground": h("error"),
        "gitDecoration.conflictingResourceForeground": n("peach", "term3"),
        "gitDecoration.ignoredResourceForeground": h("outline"),
        # integrated terminal
        "terminal.background": h("surfaceContainerLow"), "terminal.foreground": h("onSurface"),
        "terminalCursor.foreground": h("primary"), "terminal.selectionBackground": h("primary", "40"),
        **{f"terminal.ansi{name}": h(f"term{i}") for i, name in enumerate(
            ("Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White",
             "BrightBlack", "BrightRed", "BrightGreen", "BrightYellow", "BrightBlue",
             "BrightMagenta", "BrightCyan", "BrightWhite"))},
    }

    def rule(scope, colour, style=None):
        r = {"scope": scope, "settings": {"foreground": colour}}
        if style:
            r["settings"]["fontStyle"] = style
        return r

    text = n("text", "onSurface")
    token_colors = [
        rule(["comment", "punctuation.definition.comment"], n("overlay1", "outline"), "italic"),
        rule(["string", "punctuation.definition.string"], n("green", "term2")),
        rule(["string.regexp", "constant.character.escape", "constant.other.placeholder"], n("pink", "tertiary")),
        rule(["constant.numeric", "constant.language", "constant.other", "variable.other.constant",
              "variable.other.enummember", "support.constant"], n("peach", "term3")),
        rule(["keyword", "storage.type", "storage.modifier", "keyword.control"], n("mauve", "primary")),
        rule(["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value"], n("sky", "term6")),
        rule(["punctuation", "meta.brace"], n("overlay2", "outline")),
        rule(["entity.name.function", "support.function", "meta.function-call.generic",
              "variable.function"], n("blue", "term4")),
        rule(["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type",
              "support.class", "entity.name.namespace", "storage.type.primitive"], n("yellow", "term3")),
        rule(["variable", "meta.definition.variable"], text),
        rule(["variable.parameter", "meta.parameter"], n("maroon", "secondary"), "italic"),
        rule(["variable.language", "variable.language.this", "variable.language.self"], n("red", "term1"), "italic"),
        rule(["variable.other.property", "variable.other.object.property", "support.variable.property",
              "meta.object-literal.key", "entity.name.variable.field"], n("lavender", "primary")),
        rule(["support.type.property-name"], n("blue", "term4")),
        rule(["entity.name.tag"], n("mauve", "primary")),
        rule(["entity.other.attribute-name"], n("yellow", "term3"), "italic"),
        rule(["meta.decorator", "entity.name.function.decorator", "punctuation.decorator",
              "storage.type.annotation"], n("peach", "term3")),
        rule(["entity.name.function.macro", "keyword.other.preprocessor", "meta.preprocessor"], n("pink", "tertiary")),
        rule(["markup.heading", "entity.name.section"], h("primary"), "bold"),
        rule(["markup.bold"], text, "bold"),
        rule(["markup.italic"], text, "italic"),
        rule(["markup.strikethrough"], h("outline"), "strikethrough"),
        rule(["markup.underline.link", "string.other.link"], h("tertiary"), "underline"),
        rule(["markup.inline.raw", "markup.fenced_code", "markup.raw"], n("green", "term2")),
        rule(["markup.quote"], n("pink", "tertiary"), "italic"),
        rule(["markup.list punctuation.definition.list"], n("peach", "term3")),
        rule(["markup.inserted", "meta.diff.header.to-file"], h(ok)),
        rule(["markup.deleted", "meta.diff.header.from-file"], h("error")),
        rule(["markup.changed"], n("blue", "term4")),
        rule(["invalid", "invalid.illegal"], h("error")),
    ]
    theme = {
        "name": "Caelestia", "type": "light" if light else "dark", "semanticHighlighting": True,
        "colors": colors, "tokenColors": token_colors,
        "semanticTokenColors": {
            "parameter": {"foreground": n("maroon", "secondary"), "italic": True},
            "property": n("lavender", "primary"), "enumMember": n("peach", "term3"),
            "variable.readonly": n("peach", "term3"), "variable.defaultLibrary": n("red", "term1"),
            "namespace": n("yellow", "term3"), "typeParameter": n("yellow", "term3"),
            "macro": n("pink", "tertiary"), "selfParameter": {"foreground": n("red", "term1"), "italic": True},
        },
    }
    for d in dirs:
        tmp = f"{d}/.caelestia.json.tmp"
        with open(tmp, "w") as f:
            json.dump(theme, f, indent=1)
        os.replace(tmp, f"{d}/caelestia.json")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"
    if cmd == "list":
        cmd_list("--json" in args)
    elif cmd == "set" and len(args) in (2, 3):
        cmd_set(*args[1:])
    elif cmd == "current":
        cmd_current()
    elif cmd == "picker" and len(args) <= 2 and (args[1:] or ["themes"])[0] in ("themes", "wallpapers"):
        cmd_picker((args[1:] or ["themes"])[0])
    elif cmd == "sync":
        cmd_sync()
    elif cmd == "vscode":
        vscode_install()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
